App(
    appid="gps_nmea",
    name="[NMEA] GPS",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="gps_app",
    requires=["gui"],
    stack_size=1 * 1024,
    order=35,
    fap_icon="gps_10px.png",
    fap_category="GPIO",
    fap_private_libs=[
        Lib(
            name="minmea",
            sources=["minmea.c"],
            cdefines=["timegm=mktime"],
        ),
    ],
)

App(
    appid="biomap",
    name="BioMapping 3.0",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="biomap_app",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024,
    order=36,
    fap_icon="biomap_icon.png",
    fap_category="GPIO",
    sources=[
        "biomap.c",
        "gsr_sensor.c",
        "sd_logger.c",
    ],
    fap_private_libs=[
        Lib(
            name="minmea",
            sources=["minmea.c"],
            cdefines=["timegm=mktime"],
        ),
    ],
)

#!/bin/sh
# Runs Biome (format + lint) on staged visualiser files before every commit,
# auto-fixing what it can and re-staging the result. CI runs the same
# `biome check` in visualiser/ — this catches formatting/lint issues here
# instead of failing the GitHub Actions run.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

files=$(git diff --cached --name-only --diff-filter=ACMR | grep '^visualiser/' | grep -E '\.(mjs|js|css)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

if [ ! -x visualiser/node_modules/.bin/biome ]; then
  echo "pre-commit: visualiser/node_modules missing — run 'npm ci' in visualiser/ first" >&2
  exit 1
fi

rel_files=$(echo "$files" | sed 's|^visualiser/||')

(cd visualiser && ./node_modules/.bin/biome check --write --no-errors-on-unmatched $rel_files)

git add $files

(text "1  Skin sensor: current-to-voltage amplifier" (exclude_from_sim no) (at 22.86 151.13 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "cfbf4d7f-0f10-575c-a99b-baf7b9a1421b"))
(text "R3 + R4 (9.4 kOhm) keep skin current safe. R5 || C2 set the gain (47 kOhm) and a ~34 Hz low-pass." (exclude_from_sim no) (at 22.86 248.92 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7c4118a0-68b3-54dd-8892-e2f4af3c6607"))

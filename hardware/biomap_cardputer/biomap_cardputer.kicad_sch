(text "1  Skin sensor: current-to-voltage amplifier" (exclude_from_sim no) (at 22.86 151.13 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid "6a38f0c1-32c2-4298-997b-f68b3d1ab05a"))
(text "R3 + R4 (9.4 kOhm) keep skin current safe. R5 || C2 set the gain (47 kOhm) and a ~34 Hz low-pass." (exclude_from_sim no) (at 22.86 248.92 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "81833c68-34a0-4051-a109-4949883160e1"))

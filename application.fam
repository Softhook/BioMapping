    sources=[
        "biomap.c",
        "biomap_gui.c",
        "biomap_session.c",
        "biomap_render.c",
        "biomap_pipeline.c",
        "biomap_rf_cal.c",
        "minmea.c",
        "modules/gps_uart.c",
        "modules/gsr_sensor.c",
        "modules/sd_logger.c",
        "em_scan/em_scan_rf.c",
        "em_scan/em_scan_cal.c",
    ],
)
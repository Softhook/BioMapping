App(
    appid="biomap",
    name="Bio Mapping",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="biomap_app",
    requires=["gui", "storage", "notification", "expansion"],
    stack_size=4 * 1024,
    order=10,
